# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://postgres:password@localhost:5432/decision_simulator

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# AI is optional. Leave AI_PROVIDER=none to run with deterministic fallback
# explanations/parsing (no external calls, no API key needed).
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

SIMULATION_ITERATIONS=10000
CORS_ORIGINS=http://localhost:5173
